{
  "name": "@all-hours-cafe/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:pull": "prisma db pull"
  },
  "dependencies": {
    "@prisma/client": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "prisma": "^7.10.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
